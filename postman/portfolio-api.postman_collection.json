{
  "info": {
    "name": "Portfolio API",
    "description": "API collection for Rohit Sachdeva portfolio.\n\n## Setup\n1. Import this collection and `portfolio-api.postman_environment.json`\n2. Select the **Local** or **Production** environment\n3. Set `admin_secret` and `revalidate_secret` from your `.env`\n\n## Auth\n- **Admin routes** use `Authorization: Bearer {{admin_secret}}`\n- **Revalidate routes** use `Authorization: Bearer {{revalidate_secret}}`\n\n## Note\nSite settings are not exposed via admin API yet — use Prisma Studio (`npm run db:studio:prod`) for footer/contact/nav updates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "project_slug",
      "value": "ai-medical-image-verification-framework"
    },
    {
      "key": "admin_secret",
      "value": ""
    },
    {
      "key": "revalidate_secret",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public — Read",
      "item": [
        {
          "name": "List all projects",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/projects"
          }
        },
        {
          "name": "Get project by slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/projects/{{project_slug}}"
          }
        },
        {
          "name": "Get site settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/settings"
          }
        },
        {
          "name": "Get site setting by key",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/settings/name"
          },
          "description": "Returns a single setting. Key is the part after `site.` (e.g. `name`, `email`, `footer`)."
        }
      ]
    },
    {
      "name": "Admin — Projects",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{admin_secret}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"my-new-project\",\n  \"title\": \"My New Project\",\n  \"category\": \"Machine Learning and Predictive Analytics\",\n  \"description\": \"Short summary shown on listing cards.\",\n  \"icon\": \"code\",\n  \"image\": \"\",\n  \"imageAlt\": \"My new project\",\n  \"contentHtml\": \"\",\n  \"featured\": false,\n  \"published\": true,\n  \"order\": 10,\n  \"tags\": [\"Python\", \"TensorFlow\"]\n}"
            },
            "url": "{{base_url}}/api/admin/projects",
            "description": "Required: `slug`, `title`, `category`, `description`, `icon`.\n\nIcon values: `shield`, `nodes`, `face`, `chart`, `code`."
          }
        },
        {
          "name": "Update project (full)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI Medical Image Verification Framework\",\n  \"category\": \"Deep Learning and Computer Vision\",\n  \"description\": \"Updated short description.\",\n  \"icon\": \"shield\",\n  \"image\": \"/images/project-medical-ai.webp\",\n  \"imageAlt\": \"AI medical image verification framework\",\n  \"contentHtml\": \"<p>Full project write-up goes here.</p>\",\n  \"featured\": true,\n  \"published\": true,\n  \"order\": 0,\n  \"tags\": [\"Python\", \"TensorFlow\", \"OpenCV\", \"Deep Learning\"]\n}"
            },
            "url": "{{base_url}}/api/admin/projects/{{project_slug}}",
            "description": "Send only the fields you want to change. All body fields are optional on PUT."
          }
        },
        {
          "name": "Update project image",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image\": \"/images/project-medical-ai.webp\",\n  \"imageAlt\": \"AI medical image verification framework\"\n}"
            },
            "url": "{{base_url}}/api/admin/projects/{{project_slug}}",
            "description": "Upload the image file to `public/images/` first, then set the path here (e.g. `/images/my-photo.webp`)."
          }
        },
        {
          "name": "Update project content HTML",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contentHtml\": \"<h2>Overview</h2><p>Project details and findings.</p><h2>Tech stack</h2><ul><li>Python</li><li>TensorFlow</li></ul>\"\n}"
            },
            "url": "{{base_url}}/api/admin/projects/{{project_slug}}"
          }
        },
        {
          "name": "Toggle featured / published",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"featured\": true,\n  \"published\": true,\n  \"order\": 0\n}"
            },
            "url": "{{base_url}}/api/admin/projects/{{project_slug}}",
            "description": "Featured projects appear on the homepage (top 3 by order)."
          }
        },
        {
          "name": "Update project tags",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\"Python\", \"TensorFlow\", \"OpenCV\", \"Deep Learning\", \"Computer Vision\"]\n}"
            },
            "url": "{{base_url}}/api/admin/projects/{{project_slug}}",
            "description": "Replaces all tags on the project."
          }
        },
        {
          "name": "Delete project",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base_url}}/api/admin/projects/{{project_slug}}"
          }
        }
      ]
    },
    {
      "name": "Cache — Revalidate",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{revalidate_secret}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Revalidate all (projects + settings)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{base_url}}/api/revalidate",
            "description": "Empty body revalidates `projects` and `settings` cache tags."
          }
        },
        {
          "name": "Revalidate single project",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slug\": \"{{project_slug}}\"\n}"
            },
            "url": "{{base_url}}/api/revalidate"
          }
        },
        {
          "name": "Revalidate custom tags",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\"projects\", \"settings\"]\n}"
            },
            "url": "{{base_url}}/api/revalidate"
          }
        }
      ]
    }
  ]
}
