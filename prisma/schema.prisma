datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  description String
  icon        String
  image       String   @default("")
  imageAlt    String   @default("")
  contentHtml String   @default("")
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tags        ProjectTag[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  projects ProjectTag[]
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// CMS page: `sections` is JSON array of section blocks, each with a `type` component alias
/// (hero, content, cards, projects, timeline, contactDetails, form, cta).
model Page {
  id        String   @id @default(cuid())
  pageKey   String   @unique
  path      String   @unique
  seo       String
  sections  String
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
